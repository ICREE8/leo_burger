# ==============================================================================
# LEO BURGER - Standard Web & Frontend .gitignore
# ==============================================================================

# Node / Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Build & Bundler Outputs
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/

# Environment Variables & Local Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.*

# OS Generated Files (macOS & Windows)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs & Code Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Testing & Coverage
coverage/
.nyc_output/
cypress/videos/
cypress/screenshots/

# Temporary / Log files
*.log
logs/
temp/
tmp/
*.pid
*.seed

# Local Backups & Dumps
*.bak
*.orig
*.dump
*.sql
*.tar.gz
*.zip